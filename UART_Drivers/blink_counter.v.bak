
`default_nettype none

module blink_counter (
    input wire clk,
    input wire reset,
    input wire counter_en,

    output wire counter_done,
    output wire blink
);

    parameter CLK_FREQ = 50000000;

    localparam TOTAL_COUNT = 3 * CLK_FREQ;
    localparam BLINK_COUNT = CLK_FREQ / 4;

    reg [27:0] count;

    // Counter
    always @(posedge clk or posedge reset) begin
        if (reset)
            count <= 28'd0;

        else if (!counter_en)
            count <= 28'd0;

        else if (count < TOTAL_COUNT - 1)
            count <= count + 1'b1;
    end

    // Counter done after 3 seconds
    assign counter_done =
        counter_en && (count == TOTAL_COUNT - 1);

    // Blink: 0.25s ON, 0.25s OFF
    assign blink =
        counter_en &&
        ((count % (2 * BLINK_COUNT)) < BLINK_COUNT);

endmodule

`default_nettype wire