
`default_nettype none

module Arithmetic_Unit #
(
    parameter N = 4
)
(
    input wire EnableALU,
    input wire AddSub,
    input wire [N-1:0] A,
    input wire [N-1:0] B,
    output wire Carry,
    output wire [N-1:0] IB_ALU
);

    wire [N:0] sum;

    assign sum = {1'b0, B}
               + {1'b0, (A ^ {N{AddSub}})}
               + AddSub;

    assign Carry = sum[N];

    assign IB_ALU = EnableALU ?
                    sum[N-1:0] :
                    {N{1'bz}};

endmodule

`default_nettype wire